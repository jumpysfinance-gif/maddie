-- Populate players
local function refreshPlayers()
	for _, c in ipairs(dropdown:GetChildren()) do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -12, 0, 24)
		btn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
		btn.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
		btn.TextColor3 = Color3.fromRGB(0, 170, 255)
		btn.Font = Enum.Font.Gotham
		btn.TextSize = 13
		btn.AutoButtonColor = false
		btn.Parent = dropdown
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

		btn.MouseButton1Click:Connect(function()
			selectedPlayer = plr
			dropBtn.Text = plr.DisplayName .. " ▼"

			if loopOn then
				label1.Text = "Looping: " .. plr.DisplayName
			else
				label1.Text = "Loop Target: " .. plr.DisplayName
			end

			-- Auto-close dropdown
			dropdown.Size = UDim2.new(1, -40, 0, 0)
			openDrop = false
		end)
	end

	task.wait()
	dropdown.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y + 6)
end

refreshPlayers()
Players.PlayerAdded:Connect(refreshPlayers)
Players.PlayerRemoving:Connect(refreshPlayers)

