end)

-- Loop Button (Persistent & Fast)
loopBtn.MouseButton1Click:Connect(function()
	if not selectedPlayer then
		label1.Text = "Loop: No Player Selected"
		return
	end

	loopOn = not loopOn

	if loopOn then
		label1.Text = "Looping: " .. selectedPlayer.DisplayName

		-- Start persistent loop
		loopThread = task.spawn(function()
			while loopOn do
				pcall(function()
					if selectedPlayer and selectedPlayer.Character and LocalUser.Character then
						local enemyChar = selectedPlayer.Character
						local char = LocalUser.Character

						if char:FindFirstChild("LeftHand") and char:FindFirstChild("Boxing") and enemyChar:FindFirstChild("LeftHand") then
							ReplicatedStorage.Remotes.Human_Punch:FireServer(
								char.LeftHand,
								"LeftPunch",
								enemyChar.LeftHand,
								5,
								true,
								"RightPunch",
								char.Boxing.Handle.Hit,
								100
							)
						end
					end
				end)
				task.wait(0.05) -- faster loop
			end
		end)
	else
		label1.Text = selectedPlayer
			and ("Loop Target: " .. selectedPlayer.DisplayName)
			or "Loop Status: OFF"
	end
end)

-- Antihit Button
antiBtn.MouseButton1Click:Connect(function()
	antiOn = not antiOn
	label2.Text = "Antihit: " .. (antiOn and "ON" or "OFF")

	if antiOn then
		punchConn = RunService.RenderStepped:Connect(function()
			pcall(function()
				local char = LocalUser.Character
				if not char then return end

				local hum = char:FindFirstChild("Humanoid")
				if hum and hum:FindFirstChild("creator") then
					local attackerName = tostring(hum.creator.Value)
					local target = Workspace:FindFirstChild(attackerName)

					if target
						and char:FindFirstChild("RightHand")
						and char:FindFirstChild("LeftHand") then

						local hit = LocalUser.Backpack:FindFirstChild("Boxing")
							and LocalUser.Backpack.Boxing.Handle.Hit

						if hit then
							ReplicatedStorage.Remotes.Human_Punch:FireServer(
								char.RightHand,
								"RightPunch",
								target:FindFirstChild("UpperTorso") or target:FindFirstChild("HumanoidRootPart"),
								5,
								true,
								"RightPunch",
								hit,
								5
							)

							ReplicatedStorage.Remotes.Human_Punch:FireServer(
								char.LeftHand,
								"LeftPunch",
								target:FindFirstChild("UpperTorso") or target:FindFirstChild("HumanoidRootPart"),
								5,
								true,
								"LeftPunch",
								hit,
								5
							)
						end
					end
				end
			end)
		end)
	else
		if punchConn then punchConn:Disconnect() punchConn = nil end
	end
end)

-- Draggable
do
	local dragging, dragStart, startPos
	main.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = i.Position
			startPos = main.Position
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = i.Position - dragStart
			main.Position = startPos + UDim2.fromOffset(delta.X, delta.Y)
		end
	end)
end

-- Toggle UI with F
local open = true
UserInputService.InputBegan:Connect(function(i, gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.F then
		open = not open
		main.Visible = open
	end
end)
