-- Button helper
local function makeButton(text,y,color)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1,-40,0,32)
	b.Position = UDim2.fromOffset(20,y)
	b.BackgroundColor3 = Color3.fromRGB(30,30,45)
	b.Text = text
	b.TextColor3 = color
	b.Font = Enum.Font.Gotham
	b.TextSize = 14
	b.Parent = main
	Instance.new("UICorner", b).CornerRadius = UDim.new(0,14)
	return b
end

local loopBtn = makeButton("Toggle Loop",100,Color3.fromRGB(255,120,200))
local antiBtn = makeButton("Toggle Antihit",138,Color3.fromRGB(0,170,255))
local dropBtn = makeButton("Select Player ▼",176,Color3.fromRGB(255,120,200))

-- Dropdown
local dropdown = Instance.new("ScrollingFrame")
dropdown.Position = UDim2.fromOffset(20,214)
dropdown.Size = UDim2.new(1,-40,0,0)
dropdown.CanvasSize = UDim2.new(0,0,0,0)
dropdown.ScrollBarThickness = 6
dropdown.BackgroundColor3 = Color3.fromRGB(25,25,38)
dropdown.BorderSizePixel = 0
dropdown.ClipsDescendants = true
dropdown.Parent = main
Instance.new("UICorner", dropdown).CornerRadius = UDim.new(0,14)

local layout = Instance.new("UIListLayout", dropdown)
layout.Padding = UDim.new(0,6)

local openDrop = false

local function refreshPlayers()
	for _,v in ipairs(dropdown:GetChildren()) do
		if v:IsA("TextButton") then v:Destroy() end
	end

	for _,plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalUser then
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1,-12,0,24)
			b.BackgroundColor3 = Color3.fromRGB(30,30,45)
			b.Text = plr.DisplayName.." (@"..plr.Name..")"
			b.TextColor3 = Color3.fromRGB(0,170,255)
			b.Font = Enum.Font.Gotham
			b.TextSize = 13
			b.Parent = dropdown
			Instance.new("UICorner", b).CornerRadius = UDim.new(0,10)

			b.MouseButton1Click:Connect(function()
				PlayerName.Text = plr.Name
				label1.Text = "Target: "..plr.DisplayName
				openDrop = false
				dropdown.Size = UDim2.new(1,-40,0,0)
				dropBtn.Text = "Select Player ▼"
			end)
		end
	end

	task.wait()
	dropdown.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y+6)
end

dropBtn.MouseButton1Click:Connect(function()
	openDrop = not openDrop
	if openDrop then
		refreshPlayers()
		dropdown.Size = UDim2.new(1,-40,0,120)
		dropBtn.Text = "Select Player ▲"
	else
		dropdown.Size = UDim2.new(1,-40,0,0)
		dropBtn.Text = "Select Player ▼"
	end
end)

-- 🔁 LOOP (persistent, exact code)
local loopOn = false
local loopThread

loopBtn.MouseButton1Click:Connect(function()
	loopOn = not loopOn
	label1.Text = loopOn and ("Looping: "..PlayerName.Text) or "Loop Status: OFF"

	if loopOn and (not loopThread or not loopThread:IsAlive()) then
		loopThread = task.spawn(function()
			while loopOn do
				local field = PlayerName.Text
				local LocalUser = game.Players.LocalPlayer
				local ENEMY = field

				-- YOUR EXACT PUNCH CODE
				pcall(function() -- prevents errors if target disappears
					game.ReplicatedStorage.Remotes.Human_Punch:FireServer(
						LocalUser.Character.LeftHand,
						"LeftPunch",
						game.Workspace[ENEMY].LeftHand,
						5,
						true,
						"RightPunch",
						LocalUser.Backpack.Boxing.Handle.Hit,
						100
					)
				end)

				task.wait(0.05) -- repeat quickly
			end
		end)
	end
end)

-- 🛡️ ANTIHIT
local antiOn = false
local conn

antiBtn.MouseButton1Click:Connect(function()
	antiOn = not antiOn
	label2.Text = "Antihit: "..(antiOn and "ON" or "OFF")

	if antiOn then
		conn = RunService.RenderStepped:Connect(function()
			local char = LocalUser.Character
			if not char then return end
			local hum = char:FindFirstChild("Humanoid")
			if hum and hum:FindFirstChild("creator") then
				local atk = hum.creator.Value
				if atk and atk.Character then
					ReplicatedStorage.Remotes.Human_Punch:FireServer(
						char.RightHand,
						"RightPunch",
						atk.Character:FindFirstChild("HumanoidRootPart"),
						5,
						true,
						"RightPunch",
						LocalUser.Backpack.Boxing.Handle.Hit,
						5
					)
				end
			end
		end)
	else
		if conn then conn:Disconnect() conn = nil end
	end
end)

-- Drag
do
	local dragging, start, pos
	main.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			start = i.Position
			pos = main.Position
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
			local d = i.Position - start
			main.Position = pos + UDim2.fromOffset(d.X,d.Y)
		end
	end)
end

-- Toggle UI (F)
local open = true
UserInputService.InputBegan:Connect(function(i,gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.F then
		open = not open
		main.Visible = open
	end
end)
